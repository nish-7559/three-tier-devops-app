pipeline {
    agent any

    environment {
        APP_DIR = "/home/ubuntu/three-tier-devops-app"
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                sh 'docker --version'
                sh 'docker compose version'
                sh 'test -f docker-compose.yml'
                sh 'test -f backend/app.py'
                sh 'test -f database/init.sql'
                sh 'test -f frontend/index.html'
            }
        }

        stage('Build & Test Backend Image') {
            steps {
                echo 'Building backend container image...'
                sh 'docker build -t three-tier-backend:latest ./backend'
            }
        }

        stage('Deploy Containers') {
            steps {
                echo 'Deploying application stack via Docker Compose...'
                // Build images, tear down previous containers, and start clean stack
                sh 'docker compose down --remove-orphans || true'
                sh 'docker compose up -d --build'
            }
        }

        stage('Health Check') {
            steps {
                echo 'Validating application health...'
                // Allow MySQL and Flask container a brief buffer to start
                sleep time: 10, unit: 'SECONDS'
                sh '''
                    for i in {1..10}; do
                        if curl -s http://localhost:5000/health | grep -q '"status":"UP"'; then
                            echo "Backend health check PASSED!"
                            exit 0
                        fi
                        echo "Waiting for backend service to become ready..."
                        sleep 3
                    done
                    echo "Backend failed health check!"
                    docker compose logs backend
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment succeeded! Frontend accessible at http://${sh(script: 'curl -s ifconfig.me', returnStdout: true).trim()}"
        }
        failure {
            echo "Deployment failed! Printing recent container logs..."
            sh 'docker compose logs --tail=50'
        }
    }
}
